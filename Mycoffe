/* Estilos para a seção de boas-vindas com a imagem de fundo */
.hero-section {
    /* 1. Define a imagem de fundo */
    background-image: url('URL_DA_IMAGEM_DE_GRAOS'); 
    
    /* 2. Garante que a imagem cubra toda a seção sem repetição */
    background-size: cover; /* Faz a imagem cobrir a área */
    background-repeat: no-repeat; /* Evita que a imagem se repita */
    background-position: center center; /* Centraliza a imagem */
    
    /* 3. Estilos de espaçamento para que o conteúdo fique visível */
    padding: 100px 20px; /* Adiciona espaçamento interno (padding) */
    color: white; /* Muda a cor do texto para branco para contraste */
    text-align: center; /* Centraliza o texto */
    
    /* (Opcional) Adiciona uma sombra escura para melhorar a legibilidade do texto */
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7); 
}

/* Ajustes de estilo para o conteúdo (opcional, para ficar parecido com a imagem) */
.hero-title {
    font-size: 2.5em; /* Tamanho maior para o título */
    margin-bottom: 10px;
}

.hero-text {
    font-size: 1.2em;
    margin-bottom: 30px;
}

.hero-button {
    display: inline-block;
    padding: 10px 20px;
    background-color: #A0522D; /* Cor de café ou marrom para o botão */
    color: white;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}
